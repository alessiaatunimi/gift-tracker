rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/gifts/{giftId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function validGift() {
        let d = request.resource.data;
        return d.keys().hasAll(['recipient', 'idea', 'status', 'budget', 'url', 'notes', 'year'])
          && d.keys().hasOnly(['recipient', 'idea', 'status', 'budget', 'url', 'notes', 'year'])
          && d.recipient is string && d.recipient.size() > 0 && d.recipient.size() <= 100
          && d.idea is string && d.idea.size() <= 200
          && d.status in ['deciding', 'buying', 'wrapping', 'ready', 'given']
          && d.budget is number && d.budget >= 0 && d.budget <= 1000000
          && d.url is string && d.url.size() <= 2000 && (d.url == '' || d.url.matches('https?://.*'))
          && d.notes is string && d.notes.size() <= 2000
          && d.year is int && d.year >= 2000 && d.year <= 2200;
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validGift();
    }
  }
}
